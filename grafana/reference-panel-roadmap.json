    {"key":"body","priority":2,"metrics":["weight","body composition"],"requires":["verified field paths and units"]},
    {"key":"performance","priority":2,"metrics":["VO2 max","training load","readiness"],"requires":["verified field paths and semantics"]},
    {"key":"activity_detail","priority":3,"metrics":["GPS","pace","speed","altitude","cadence","HR stream"],"requires":["activity_details schema and stream coverage"]},
    {"key":"strength","priority":3,"metrics":["sets","reps","weight","volume","estimated 1RM","HR zones"],"requires":["verified strength records and fields"]}
