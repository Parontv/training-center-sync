    {
      "title": "Garmin Strength Training Dashboard",
      "uid": "garmin-strength-training",
      "panels": [
        {
          "id": 1001,
          "title": "Overview",
          "type": "row",
          "description": ""
        },
        {
          "id": 1002,
          "title": "Total Volume",
          "type": "stat",
          "description": "Sum of Reps x Weight_kg across all sets in range (Weight_kg>0 only; excludes cardio warmups)."
        },
        {
          "id": 1003,
          "title": "Weighted Sets",
          "type": "stat",
          "description": "Count of sets with Weight_kg > 0 in range. This excludes bodyweight/cardio-only entries (e.g. unweighted pull-ups, ROW/INDOOR_ROW warmups) that are logged inside strength activities but carry no load — so this number is lower than the raw row count for the same range. See 'Sets Needing Classification' below for data-quality flags."
        },
        {
          "id": 1004,
          "title": "Total Reps",
          "type": "stat",
          "description": "Sum of reps across weighted sets in range."
        },
        {
          "id": 1005,
          "title": "Number of Workouts",
          "type": "stat",
          "description": "Distinct days with at least one weighted set (one row per training day)."
        },
        {
          "id": 1006,
          "title": "Avg Volume / Workout",
          "type": "stat",
          "description": "Mean per-workout training volume in range."
        },
        {
          "id": 1007,
          "title": "Progression & Volume",
          "type": "row",
          "description": ""
        },
        {
          "id": 1008,
          "title": "Estimated 1RM Progression (Epley) by Exercise",
          "type": "timeseries",
          "description": "Best estimated 1-rep max per exercise per workout day, using the Epley formula Weight_kg * (1 + Reps/30). Filter by $ExerciseCategory / $ExerciseLabel above. This is the single most useful panel for tracking progressive overload."
        },
        {
          "id": 1009,
          "title": "Training Volume per Workout",
          "type": "barchart",
          "description": "Total volume (kg) per workout day (Reps x Weight_kg, summed across all weighted sets that day)."
        },
        {
          "id": 1010,
          "title": "Personal Records (Top Set & Est. 1RM)",
          "type": "table",
          "description": "Heaviest single set and best estimated 1RM (Epley) per exercise in the selected range."
        },
        {
          "id": 1011,
          "title": "Exercise Balance & Workout Log",
          "type": "row",
          "description": ""
        },
        {
          "id": 1012,
          "title": "Volume by Category",
          "type": "piechart",
          "description": "Training volume (kg) split by exercise category — shows muscle-group balance."
        },
        {
          "id": 1013,
          "title": "Sets by Category",
          "type": "barchart",
          "description": "Number of weighted sets per exercise category — complements the volume pie (a category can have many sets but low volume, or vice versa)."
        },
        {
          "id": 1014,
          "title": "Recent Sets (Workout Detail)",
          "type": "table",
          "description": "Most recent individual sets: exercise, reps, weight, and volume."
        },
        {
          "id": 1015,
          "title": "Workout Summary (per session)",
          "type": "table",
          "description": "One row per workout day: total sets, reps, volume, and cumulative active set duration. Not filtered by exercise picker (whole-session view)."
        },
        {
          "id": 1016,
          "title": "Heart Rate & Effort",
          "type": "row",
          "description": ""
        },
        {
          "id": 1017,
          "title": "HR Zone Time Distribution (Strength Sessions)",
          "type": "piechart",
          "description": "Time spent in each heart-rate zone during strength sessions, from StrengthHRZones. ZoneNumber/ZoneLowBoundary are per-activity fields (not tags), so each zone is queried as a separate target filtered by ZoneNumber."
        },
        {
          "id": 1018,
          "title": "Time Under Tension by Exercise",
          "type": "barchart",
          "description": "Total accumulated active-set duration (sum of Duration_s) per exercise in the selected range."
        },
        {
          "id": 1019,
          "title": "Consistency & Data Quality",
          "type": "row",
          "description": ""
        },
        {
          "id": 1020,
          "title": "Workouts per Week",
          "type": "barchart",
          "description": "Count of training days bucketed into weekly bins. fill(0) is intentional here: a week with no workout genuinely has zero, not missing data."
        },
        {
          "id": 1021,
          "title": "Workout Calendar",
          "type": "state-timeline",
          "description": "One cell per calendar day: green = at least one weighted set logged that day, gray = rest day."
        },
        {
          "id": 1022,
          "title": "Sets Needing Classification (UNKNOWN)",
          "type": "stat",
          "description": "Sets Garmin could not classify into an exercise (ExerciseCategory=UNKNOWN). Not dropped from other panels, but flagged here — fix labels in Garmin Connect to improve categorization."
        }
      ]
    }
  ],
  "note": "Panel inventory for adapting into verified Training Center D1 fields only."
}